{
  "name": "novex-backend",
  "version": "2.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"core/**/*.ts\"",
    "start": "nest start user",
    "start:dev": "nest start identity --watch",
    "start:debug": "nest start identity --debug --watch",
    "start:prod": "node dist/apps/identity/main",
    "start:trading": "nest start trading",
    "start:trading:dev": "nest start trading --watch",
    "lint": "eslint \"{apps,core,tests}/**/*.ts\" --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --config .jestrc.json",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --detectOpenHandles -i --config jest-e2e.json",
    "depcruise": "depcruise",
    "deps:validate": "npm run deps:validate:campaign && npm run deps:validate:catalog && npm run deps:validate:identity && npm run deps:validate:integration && npm run deps:validate:reward",
    "deps:graph": "npm run deps:graph:campaign && npm run deps:graph:catalog && npm run deps:graph:identity && npm run deps:graph:integration && npm run deps:graph:reward",
    "deps:validate:campaign": "depcruise apps/campaign/src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph:campaign": "depcruise apps/campaign/src --include-only \"^apps/campaign/src\" --config .dependency-cruiser.js --output-type dot > assets/dependency-graph.dot",
    "deps:validate:catalog": "depcruise apps/catalog/src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph:catalog": "depcruise apps/catalog/src --include-only \"^apps/catalog/src\" --config .dependency-cruiser.js --output-type dot > assets/dependency-graph.dot",
    "deps:validate:identity": "depcruise apps/identity/src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph:identity": "depcruise apps/identity/src --include-only \"^apps/identity/src\" --config .dependency-cruiser.js --output-type dot > assets/dependency-graph.dot",
    "deps:validate:integration": "depcruise apps/integration/src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph:integration": "depcruise apps/integration/src --include-only \"^apps/integration/src\" --config .dependency-cruiser.js --output-type dot > assets/dependency-graph.dot",
    "deps:validate:reward": "depcruise apps/reward/src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph:reward": "depcruise apps/reward/src --include-only \"^apps/reward/src\" --config .dependency-cruiser.js --output-type dot > assets/dependency-graph.dot",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^13.4.0",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-prometheus": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.27.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.64.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "env-var": "^7.5.0",
    "graphql": "^16.14.0",
    "helmet": "^8.1.0",
    "nanoid": "^5.1.11",
    "nestjs-console": "^10.0.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-request-context": "^4.0.0",
    "node-vault": "^0.12.0",
    "oxide.ts": "^1.1.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slonik": "^48.14.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "artillery": "^2.0.30",
    "artillery-plugin-faker": "^6.0.1",
    "dependency-cruiser": "^17.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-cucumber": "^4.5.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-essentials": "^10.2.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "preset": "ts-jest",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/core/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/libs(|/.*)$": "<rootDir>/libs/$1",
      "^@campaign/(.*)$": "<rootDir>/apps/campaign/src/$1",
      "^@catalog/(.*)$": "<rootDir>/apps/catalog/src/$1",
      "^@core$": "<rootDir>/core/index.ts",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@identity/(.*)$": "<rootDir>/apps/identity/src/$1",
      "^@integration/(.*)$": "<rootDir>/apps/integration/src/$1",
      "^@reward/(.*)$": "<rootDir>/apps/reward/src/$1",
      "^@tests/(.*)$": "<rootDir>/tests/$1",
      "^@trading/(.*)$": "<rootDir>/apps/trading/src/$1"
    }
  }
}
